<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cl_dialog">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <EditText
            android:id="@+id/q_title"
            style="@style/ChasseLogField"
            android:layout_marginTop="0dp"
            android:hint="Titre de la journée"
            android:inputType="textCapSentences"
            android:maxLength="80" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/q_modes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <LinearLayout
            android:id="@+id/q_roles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />
        <EditText
            android:id="@+id/q_host"
            style="@style/ChasseLogField"
            android:hint="Invité par"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="60"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/ChasseLogLabel" android:text="Date" />
                <TextView android:id="@+id/q_date" style="@style/ChasseLogField" android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/ChasseLogLabel" android:text="Heure de RDV" />
                <TextView android:id="@+id/q_time" style="@style/ChasseLogField" android:layout_marginTop="4dp" android:hint="–" />
            </LinearLayout>
        </LinearLayout>
        <EditText
            android:id="@+id/q_place"
            style="@style/ChasseLogField"
            android:hint="Lieu de RDV"
            android:inputType="textCapSentences"
            android:maxLength="80" />
        <EditText
            android:id="@+id/q_notes"
            style="@style/ChasseLogField"
            android:hint="Consignes et notes"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:maxLines="4" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/q_cancel"
                style="@style/ChasseLogChoice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Annuler"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/q_save"
                style="@style/ChasseLogChoice"
                android:layout_width="0dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/cl_chip_on"
                android:text="Enregistrer"
                android:textColor="@color/cl_on_acc"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
