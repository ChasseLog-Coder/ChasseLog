{
  "appId": "be.chasselog.app",
  "appName": "ChasseLog",
  "webDir": "www",
  "android": {
    "appendUserAgent": "ChasseLog-Android",
    "backgroundColor": "#f1efe6"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT"
    },
    "Keyboard": {
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_chasselog",
      "iconColor": "#3F5A2B"
    }
  }
}